{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "title": "API para Proyecto Matriz RAC",
  "scripts": {
    "build:all": "nest build",
    "format": "prettier --write \"../../../**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "nest start --watch",
    "start:prod:all": "pm2 start pm2.json --env production",
    "start:dev:all": "pm2 start pm2.json",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@automapper/classes": "^8.8.1",
    "@automapper/core": "^8.8.1",
    "@automapper/nestjs": "^8.8.1",
    "@automapper/types": "^6.3.1",
    "@dynamic-mapper/mapper": "^1.10.4",
    "@fastify/static": "^7.0.4",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "~11.0.12",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-fastify": "10.4.9",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjstools/messaging": "^2.4.2",
    "@nestjstools/messaging-rabbitmq-extension": "^2.4.3",
    "@nestjstools/microservices-rabbitmq": "^1.1.0",
    "@repo/api": "workspace:*",
    "@types/amqplib": "^0.10.7",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "cache-manager": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "fastify": "^4.28.1",
    "jest-html-reporters": "^3.1.7",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.2.3",
    "nest-keycloak-connect": "^1.9.2",
    "nestjs-paginate": "^10.0.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-soap": "^3.0.2",
    "pg": "^8.14.1",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "ts-mapper": "^1.2.4",
    "typeorm": "^0.3.21",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "./unit-test-report",
          "filename": "index.html",
          "openReport": true
        }
      ]
    ]
  }
}
